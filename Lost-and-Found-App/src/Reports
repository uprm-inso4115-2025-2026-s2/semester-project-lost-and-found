export type ReportStatus = 'ACTIVE' | 'RESOLVED' | 'ARCHIVED';

export interface CreateReportProps {
  title: string;
  description: string;
  dateFound: Date;
  location: string;
  categories?: string[];
  imageUrl?: string;
  createdBy: string;
}

export interface UpdateReportProps {
  title?: string;
  description?: string;
  dateFound?: Date;
  location?: string;
  categories?: string[];
  imageUrl?: string | null;
}

export interface ReportRow {
  id: string;
  title: string;
  description: string;
  date_found: string;
  location: string;
  categories: string[] | null;
  image_url: string | null;
  created_by: string;
  status: ReportStatus;
}

export class Report {
  public readonly id: string;
  public readonly title: string;
  public readonly description: string;
  public readonly dateFound: Date;
  public readonly location: string;
  public readonly categories: string[];
  public readonly imageUrl?: string;
  public readonly createdBy: string;
  public readonly status: ReportStatus;

  private constructor(
    id: string,
    props: CreateReportProps,
    status: ReportStatus
  ) {
    this.id = id;
    this.title = props.title.trim();
    this.description = props.description.trim();
    this.dateFound = props.dateFound;
    this.location = props.location.trim();
    this.categories = props.categories ?? [];
    this.imageUrl = props.imageUrl;
    this.createdBy = props.createdBy.trim();
    this.status = status;
  }

  static create(props: CreateReportProps): Report {
    const id =
      typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
        ? crypto.randomUUID()
        : `report_${Date.now()}`;

    return new Report(id, props, 'ACTIVE');
  }

  static fromRow(row: ReportRow): Report {
    return new Report(
      row.id,
      {
        title: row.title,
        description: row.description,
        dateFound: new Date(row.date_found),
        location: row.location,
        categories: row.categories ?? [],
        imageUrl: row.image_url ?? undefined,
        createdBy: row.created_by,
      },
      row.status
    );
  }

  toUpdateRow(updates: UpdateReportProps) {
    return {
      ...(updates.title !== undefined ? { title: updates.title.trim() } : {}),
      ...(updates.description !== undefined
        ? { description: updates.description.trim() }
        : {}),
      ...(updates.dateFound !== undefined
        ? { date_found: updates.dateFound.toISOString() }
        : {}),
      ...(updates.location !== undefined
        ? { location: updates.location.trim() }
        : {}),
      ...(updates.categories !== undefined
        ? { categories: updates.categories }
        : {}),
      ...(updates.imageUrl !== undefined ? { image_url: updates.imageUrl } : {}),
    };
  }

  getEditableFields() {
    return {
      title: this.title,
      description: this.description,
      dateFound: this.dateFound,
      location: this.location,
      categories: this.categories,
      imageUrl: this.imageUrl ?? '',
    };
  }

  canBeEditedBy(userId: string | null | undefined) {
    return Boolean(userId) && this.createdBy === userId;
  }

  getId(): string {
    return this.id;
  }

  getTitle(): string {
    return this.title;
  }

  getDescription(): string {
    return this.description;
  }

  getDateFound(): Date {
    return this.dateFound;
  }

  getLocation(): string {
    return this.location;
  }

  getCategories(): string[] {
    return this.categories;
  }

  getImageUrl(): string | undefined {
    return this.imageUrl;
  }

  getCreatedBy(): string {
    return this.createdBy;
  }

  getStatus(): ReportStatus {
    return this.status;
  }
}

const report = Report.create({
  title: 'I Phone 6 Million',
  description: 'FUN EVENT',
  dateFound: new Date('2026-02-26'),
  location: 'Choliseo',
  categories: ['Electronics', 'Clothing'],
  imageUrl: undefined,
  createdBy: 'Sasuke',
});

console.log('ID:', report.getId());
